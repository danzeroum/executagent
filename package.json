{
  "name": "executagent",
  "version": "0.1.0",
  "private": true,
  "description": "Executagent — structured task execution via AI skills.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:studio": "pnpm --filter @executagent/studio dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
