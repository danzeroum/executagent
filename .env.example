# ──────────────────────────────────────────────────────────────────────────
# Executagent — environment template. Copy to `.env` (never commit `.env`).
# Edge Function secrets live in `supabase/.env` (also git-ignored) or in the
# Supabase dashboard / Vault for hosted deployments.
# ──────────────────────────────────────────────────────────────────────────

# ── Frontend (apps/studio, Vite — only VITE_* is exposed to the browser) ────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Functions / server-side (NEVER expose to the browser) ──────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Model providers (managed APIs — hybrid mode)
ANTHROPIC_API_KEY=sk-ant-...
IMAGE_API_KEY=your-image-provider-key

# Artifact integrity signing key (HMAC). Generate a random 32+ byte secret.
ARTIFACT_SIGNING_KEY=change-me-to-a-long-random-secret

# Carbon estimate factors (documented defaults; override per region/model).
# kWh per 1k tokens (text) and per image — see packages/core/src/carbon.ts.
CARBON_GRID_INTENSITY_G_PER_KWH=475
