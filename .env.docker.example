# Executagent Studio — Docker/VPS deployment. Copy to `.env` next to docker-compose.yml.

# Managed Supabase project the Studio talks to (the anon/publishable key is browser-safe).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public hostname for the Studio (Traefik routes this to the container).
STUDIO_HOST=studio.yourdomain.com

# Existing Traefik setup on the VPS.
PROXY_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt
